  "rules": {
    "membership": {
      "title": "Real dyadic orthogonality",
      "statement": "All entries are in Z[1/2] and U^T U = I. For a real matrix, this is the unitary condition.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    },
    "column": {
      "title": "Column-by-column reduction",
      "statement": "Reduce the active column to its matching standard basis vector while fixing previously completed columns. This trace uses ascending column order.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    },
    "lde": {
      "title": "Least denominator exponent",
      "statement": "k is the smallest nonnegative integer for which 2^k v is integral. If k > 0, an odd entry in the lift witnesses minimality.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    },
    "residues": {
      "title": "Odd entries occur in multiples of four",
      "statement": "For an integral lift w = 2^k v of a unit vector with k > 0, sum(w_i^2) = 4^k. Modulo four, the number of odd w_i is therefore divisible by four.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    },
    "signs": {
      "title": "Normalize odd residues",
      "statement": "For each selected odd entry, choose its sign so its residue modulo four is one. A sign flip is orthogonal and leaves other rows unchanged.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    },
    "quartet": {
      "title": "Even output from a normalized quartet",
      "statement": "For four integers congruent to one modulo four, K times that quartet has even integer entries. After all odd quartets have been treated, the active column admits a smaller denominator exponent.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    },
    "integral": {
      "title": "Integral unit-vector base case",
      "statement": "An integral real unit vector is a signed standard basis vector. A swap and, if necessary, a sign map it to the desired basis vector.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    },
    "completion": {
      "title": "Completed-column invariant",
      "statement": "A completed column equals its target standard basis vector; later row operations must preserve every completed column.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    },
    "recovery": {
      "title": "Invert the reduction",
      "statement": "If g_m ... g_1 U = I, then U = g_1^-1 ... g_m^-1. Gate execution on column vectors proceeds from the rightmost factor to the leftmost.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    },
    "verification": {
      "title": "Exact equality check",
      "statement": "Compare both sides entry by entry using exact rational arithmetic. Arithmetic checks do not certify arbitrary prose explanations.",
      "source_url": "https://arxiv.org/pdf/1908.06076"
    }
  },
