    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 2
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "verifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification"
