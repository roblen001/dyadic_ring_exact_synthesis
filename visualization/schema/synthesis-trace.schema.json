{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dyadic-viz:synthesis-trace:1.1.0",
  "title": "Exact dyadic orthogonal synthesis visualization trace",
  "description": "Proof-carrying visualization data. JSON Schema checks shape; exact cross-reference and arithmetic checks are specified by docs/trace-contract.md and validation.py.",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "mock",
            "compiler"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "producer",
        "note"
      ],
      "additionalProperties": false
    },
    "conventions": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "orthogonal_dyadic"
        },
        "action": {
          "const": "left"
        },
        "index_base": {
          "const": 0
        },
        "basis_order": {
          "type": "string",
          "minLength": 1
        },
        "circuit_time_order": {
          "const": "earliest_first"
        }
      },
      "required": [
        "profile",
        "action",
        "index_base",
        "basis_order",
        "circuit_time_order"
      ],
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "qubit_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "input_matrix_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "target_matrix_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "initial_state_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "column_order": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "reduction_strategy": {
          "enum": [
            "columnwise",
            "integral_then_normalize"
          ]
        }
      },
      "required": [
        "dimension",
        "qubit_count",
        "input_matrix_id",
        "target_matrix_id",
        "initial_state_id",
        "column_order"
      ],
      "additionalProperties": false
    },
    "matrices": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/matrix"
      }
    },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
